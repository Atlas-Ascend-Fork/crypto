#include "keccak_f1600_tensor.cpp"

extern "C" void CannCryptoKeccakLaunch(
    uint32_t blockDim, void* stream, const uint32_t* input, uint32_t* output, uint32_t batch)
{
    // GM_ADDR adds the __gm__ address space; use the CANN launch cast.
    keccak_f1600_tensor<<<blockDim, nullptr, stream>>>((GM_ADDR)input, (GM_ADDR)output, batch);
}
