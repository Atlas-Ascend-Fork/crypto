// Tiling data structure and kernel constants
struct Aes128CtrTilingData {
    uint32_t rd_key[44];
    uint8_t nonce[12];
    uint32_t input_length;
};

constexpr uint32_t BLOCK_NUM = 1280;
constexpr uint32_t TILE_LENGTH = 16 * BLOCK_NUM;
constexpr uint32_t ONE_RANK = 65536;
constexpr uint32_t HALF_ROW = 256;
constexpr uint32_t ALIGN = 512;
constexpr uint64_t MAX_INPUT_LENGTH = static_cast<uint64_t>(std::numeric_limits<uint32_t>::max()) - (ALIGN - 1);

uint32_t CheckedInputLength(const torch::Tensor& input)
{
    const int64_t rawSize = input.numel();
    TORCH_CHECK(
        rawSize <= static_cast<int64_t>(MAX_INPUT_LENGTH),
        "input length exceeds the maximum representable by the 32-bit aligned kernel metadata");
    return static_cast<uint32_t>(rawSize);
}

