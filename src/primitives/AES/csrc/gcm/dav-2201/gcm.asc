// Tiling data structure and kernel constants
constexpr uint32_t GHASH_CORE_NUM = 36;
constexpr uint32_t GCM_TAG_SIZE = 16;
struct Aes128GcmTilingData {
    uint32_t rd_key[44];
    uint8_t nonce[12];
    uint32_t totalDataSize;
    uint32_t aad_len;
    uint8_t aad[32];
    uint32_t numCores;
    uint32_t ghashCoreNum;
};

