// clang-format on

// Kernel constants
constexpr uint32_t BLOCK_NUM = 1280;
constexpr uint32_t TILE_LENGTH = 16 * BLOCK_NUM;
constexpr uint32_t ONE_RANK = 65536;
constexpr uint32_t HALF_ROW = 256;
constexpr uint32_t ALIGN = 512;

// Vector auxiliary functions
#pragma begin_pipe(V)
__aicore__ inline void XorNew(
    const AscendC::LocalTensor<uint16_t>& dstTensor, const AscendC::LocalTensor<uint16_t>& src0Tensor,
    const AscendC::LocalTensor<uint16_t>& src1Tensor, const AscendC::LocalTensor<uint16_t>& tmp0Tensor,
    const AscendC::LocalTensor<uint16_t>& tmp1Tensor, const uint32_t calCount)
{
    AscendC::SetMaskCount();
    AscendC::SetVectorMask<uint16_t, AscendC::MaskMode::COUNTER>(calCount);
    const AscendC::BinaryRepeatParams binaryParams;
    AscendC::Or<uint16_t, false>(tmp0Tensor, src0Tensor, src1Tensor, AscendC::MASK_PLACEHOLDER, 1, binaryParams);
    AscendC::And<uint16_t, false>(tmp1Tensor, src0Tensor, src1Tensor, AscendC::MASK_PLACEHOLDER, 1, binaryParams);
    AscendC::PipeBarrier<PIPE_V>();
    const AscendC::LocalTensor<int16_t>& dstTensorS = dstTensor.ReinterpretCast<int16_t>();
    const AscendC::LocalTensor<int16_t>& tmp0TensorS = tmp0Tensor.ReinterpretCast<int16_t>();
    const AscendC::LocalTensor<int16_t>& tmp1TensorS = tmp1Tensor.ReinterpretCast<int16_t>();
    AscendC::Sub<int16_t, false>(dstTensorS, tmp0TensorS, tmp1TensorS, AscendC::MASK_PLACEHOLDER, 1, binaryParams);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::SetMaskNorm();
    AscendC::ResetMask();
}
#pragma end_pipe

__aicore__ inline void And32(
    const AscendC::LocalTensor<uint32_t>& dst, const AscendC::LocalTensor<uint32_t>& src0,
    const AscendC::LocalTensor<uint32_t>& src1, const int32_t& count)
{
    const AscendC::LocalTensor<uint16_t>& dst_16 = dst.ReinterpretCast<uint16_t>();
    const AscendC::LocalTensor<uint16_t>& src0_16 = src0.ReinterpretCast<uint16_t>();
    const AscendC::LocalTensor<uint16_t>& src1_16 = src1.ReinterpretCast<uint16_t>();
    AscendC::And(dst_16, src0_16, src1_16, 2 * count);
}

__aicore__ inline void Xor32(
    const AscendC::LocalTensor<uint32_t>& dstTensor, const AscendC::LocalTensor<uint32_t>& src0Tensor,
    const AscendC::LocalTensor<uint32_t>& src1Tensor, const AscendC::LocalTensor<uint32_t>& tmp0Tensor,
    const AscendC::LocalTensor<uint32_t>& tmp1Tensor, const uint32_t calCount)
{
    const AscendC::LocalTensor<uint16_t>& dstTensor16 = dstTensor.ReinterpretCast<uint16_t>();
    const AscendC::LocalTensor<uint16_t>& src0Tensor16 = src0Tensor.ReinterpretCast<uint16_t>();
    const AscendC::LocalTensor<uint16_t>& src1Tensor16 = src1Tensor.ReinterpretCast<uint16_t>();
    const AscendC::LocalTensor<uint16_t>& tmp0Tensor16 = tmp0Tensor.ReinterpretCast<uint16_t>();
    const AscendC::LocalTensor<uint16_t>& tmp1Tensor16 = tmp1Tensor.ReinterpretCast<uint16_t>();
    XorNew(dstTensor16, src0Tensor16, src1Tensor16, tmp0Tensor16, tmp1Tensor16, 2 * calCount);
}

__aicore__ static inline uint32_t bswap32(uint32_t x)
{
    uint32_t mask = 0xff;
    return ((x & mask << 8 * 3) >> 8 * 3) | ((x & mask << 8 * 2) >> 8 * 1) | ((x & mask << 8 * 1) << 8 * 1) |
           ((x & mask << 8 * 0) << 8 * 3);
}

__aicore__ static inline uint8_t gf_mul(uint8_t a, uint8_t b)
{
    uint8_t res = 0;
    for (int i = 0; i < 8; i++) {
        if (b & 1)
            res ^= a;
        bool carry = a & 0x80;
        a <<= 1;
        if (carry)
            a ^= 0x1b;
        b >>= 1;
    }
    return res;
}

__aicore__ inline void aes_encrypt_single_block(
    const uint8_t key[16], const uint8_t input[16], uint8_t output[16], const uint32_t round_keys[44])
{
    uint8_t state[16];
    for (int i = 0; i < 16; i++)
        state[i] = input[i];
    const uint8_t* rk_bytes = (const uint8_t*)round_keys;
    for (int i = 0; i < 16; i++)
        state[i] ^= rk_bytes[i];
    for (int round = 1; round <= 9; round++) {
        for (int i = 0; i < 16; i++)
            state[i] = TBL_AES_SBOX[state[i]];
        uint8_t tmp[16];
        tmp[0] = state[0];
        tmp[1] = state[5];
        tmp[2] = state[10];
        tmp[3] = state[15];
        tmp[4] = state[4];
        tmp[5] = state[9];
        tmp[6] = state[14];
        tmp[7] = state[3];
        tmp[8] = state[8];
        tmp[9] = state[13];
        tmp[10] = state[2];
        tmp[11] = state[7];
        tmp[12] = state[12];
        tmp[13] = state[1];
        tmp[14] = state[6];
        tmp[15] = state[11];
        for (int i = 0; i < 16; i++)
            state[i] = tmp[i];
        for (int col = 0; col < 4; col++) {
            uint8_t s0 = state[col * 4];
            uint8_t s1 = state[col * 4 + 1];
            uint8_t s2 = state[col * 4 + 2];
            uint8_t s3 = state[col * 4 + 3];
            state[col * 4] = gf_mul(0x02, s0) ^ gf_mul(0x03, s1) ^ s2 ^ s3;
            state[col * 4 + 1] = s0 ^ gf_mul(0x02, s1) ^ gf_mul(0x03, s2) ^ s3;
            state[col * 4 + 2] = s0 ^ s1 ^ gf_mul(0x02, s2) ^ gf_mul(0x03, s3);
            state[col * 4 + 3] = gf_mul(0x03, s0) ^ s1 ^ s2 ^ gf_mul(0x02, s3);
        }
        const uint8_t* rk = rk_bytes + round * 16;
        for (int i = 0; i < 16; i++)
            state[i] ^= rk[i];
    }
    for (int i = 0; i < 16; i++)
        state[i] = TBL_AES_SBOX[state[i]];
    uint8_t tmp[16];
    tmp[0] = state[0];
    tmp[1] = state[5];
    tmp[2] = state[10];
    tmp[3] = state[15];
    tmp[4] = state[4];
    tmp[5] = state[9];
    tmp[6] = state[14];
    tmp[7] = state[3];
    tmp[8] = state[8];
    tmp[9] = state[13];
    tmp[10] = state[2];
    tmp[11] = state[7];
    tmp[12] = state[12];
    tmp[13] = state[1];
    tmp[14] = state[6];
    tmp[15] = state[11];
    for (int i = 0; i < 16; i++)
        state[i] = tmp[i];
    const uint8_t* rk = rk_bytes + 10 * 16;
    for (int i = 0; i < 16; i++)
        state[i] ^= rk[i];
    for (int i = 0; i < 16; i++)
        output[i] = state[i];
}

__aicore__ inline void GF128MulBigEndian(
    AscendC::LocalTensor<uint8_t>& a, const AscendC::LocalTensor<uint8_t>& b, AscendC::LocalTensor<uint8_t>& tmp)
{
    unsigned __int128 a_int = 0;
    for (int i = 0; i < 16; i++)
        a_int = (a_int << 8) | a.GetValue(i);
    unsigned __int128 b_int = 0;
    for (int i = 0; i < 16; i++)
        b_int = (b_int << 8) | b.GetValue(i);
    unsigned __int128 res = 0;
    const unsigned __int128 R = (unsigned __int128)0xE1 << 120;
    for (int i = 0; i < 128; i++) {
        if (b_int >> 127)
            res ^= a_int;
        bool carry = a_int & 1;
        a_int >>= 1;
        if (carry)
            a_int ^= R;
        b_int <<= 1;
    }
    for (int i = 15; i >= 0; i--)
        a.SetValue(15 - i, (res >> (8 * i)) & 0xFF);
}

// AES-128-GCM encryption kernel class
class AES128GCMEncrypt {
public:
    __aicore__ inline AES128GCMEncrypt() {}
    __aicore__ inline void Init(
        uint32_t totalDataSize, uint32_t numCores, GM_ADDR __restrict__ in, GM_ADDR __restrict__ out,
        const __gm__ Aes128GcmTilingData* __restrict__ ctx_ptr, AscendC::TPipe* pipe)
    {
        for (int i = 0; i < 44; i++)
            local_rd_key[i] = ctx_ptr->rd_key[i];
        for (int i = 0; i < 12; i++)
            local_nonce[i] = ctx_ptr->nonce[i];
        uint32_t coreId = static_cast<uint32_t>(AscendC::GetBlockIdx());
        uint32_t coreNum = numCores;
        uint32_t avgRawBytes = (totalDataSize + coreNum - 1) / coreNum;
        uint32_t core_start_raw = coreId * avgRawBytes;
        uint32_t core_end_raw =
            (core_start_raw + avgRawBytes) > totalDataSize ? totalDataSize : (core_start_raw + avgRawBytes);
        if (core_start_raw >= totalDataSize) {
            core_start_raw = core_end_raw = 0;
        }
        core_start_byte = (core_start_raw / ALIGN) * ALIGN;
        core_end_byte = ((core_end_raw + ALIGN - 1) / ALIGN) * ALIGN;
        if (core_end_byte > totalDataSize) {
            core_end_byte = totalDataSize;
        }
        if (core_start_byte >= core_end_byte) {
            core_start_byte = core_end_byte = 0;
        }
        global_block_idx = core_start_byte / 16;
        block_num = 0;
        tile_length = 0;
        inGm.SetGlobalBuffer((__gm__ uint8_t*)in + core_start_byte, core_end_byte - core_start_byte);
        outGm.SetGlobalBuffer((__gm__ uint8_t*)out + core_start_byte, core_end_byte - core_start_byte);
        pipe->InitBufPool(bufPool12, 2 * ONE_RANK - TILE_LENGTH - 2 * HALF_ROW);
        pipe->InitBuffer(inQueue, 1, TILE_LENGTH);
        pipe->InitBuffer(sBoxBuf, 2 * HALF_ROW);
        pipe->InitBufPool(bufPool3, ONE_RANK);
        bufPool12.InitBufPool(bufPool1, ONE_RANK);
        bufPool12.InitBufPool(bufPool2, 2 * (TILE_LENGTH + HALF_ROW));
        bufPool1.InitBuffer(r0g0, 2 * TILE_LENGTH + HALF_ROW);
        bufPool1.InitBuffer(r0g1, TILE_LENGTH + HALF_ROW);
        bufPool2.InitBuffer(r1g0, TILE_LENGTH + HALF_ROW);
        bufPool2.InitBuffer(r1g1, TILE_LENGTH + HALF_ROW);
        bufPool3.InitBuffer(r2g0, 2 * TILE_LENGTH + HALF_ROW);
        bufPool3.InitBuffer(r2g1, TILE_LENGTH + HALF_ROW);
        pipe->InitBufPool(bufPoolSubBytes, 4 * TILE_LENGTH, bufPool12);
        bufPoolSubBytes.InitBuffer(subBytesBuf, 4 * TILE_LENGTH);
        pipe->InitBufPool(bufPoolTrans, ONE_RANK, bufPool3);
        bufPoolTrans.InitBuffer(transBuf, 16 * (2 * BLOCK_NUM + HALF_ROW));
        bufPoolTrans.InitBuffer(outQueue, 1, TILE_LENGTH);
        sBoxHalf = sBoxBuf.Get<half>();
        sBoxHalf.SetSize(TILE_LENGTH);
        const AscendC::LocalTensor<uint64_t>& s_box_u64 = sBoxHalf.ReinterpretCast<uint64_t>();
        const uint64_t* s_box_ptr = (const uint64_t*)S_BOX_HALF;
        for (uint32_t i = 0; i < 64; i++) {
            s_box_u64.SetValue(i, s_box_ptr[i]);
        }
    }
    __aicore__ inline void Process()
    {
        uint32_t remain = core_end_byte - core_start_byte;
        uint32_t cur_offset = 0;
        while (remain > 0) {
            tile_length = (remain > TILE_LENGTH) ? TILE_LENGTH : remain;
            block_num = tile_length / 16;
            CopyIn(cur_offset);
            Compute();
            CopyOut(cur_offset);
            cur_offset += tile_length;
            remain -= tile_length;
            global_block_idx += block_num;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<uint8_t> inLocal = inQueue.AllocTensor<uint8_t>();
        AscendC::DataCopy(inLocal, inGm[offset], tile_length);
        inQueue.EnQue(inLocal);
    }
    __aicore__ inline void Compute()
    {
        GenerateCounterSubBytes(&local_rd_key[0], global_block_idx, block_num);
#pragma unroll 1
        for (uint32_t i = 1; i < 10; i++) {
            MixColumns();
            AddRoundKeyShiftRows(&local_rd_key[4 * i]);
            SubBytes();
        }
        AddRoundKeyFinal(&local_rd_key[40]);
        Trans();
        AscendC::LocalTensor<uint16_t> inLocal = inQueue.DeQue<uint16_t>();
        AscendC::LocalTensor<uint16_t> outLocal = outQueue.AllocTensor<uint16_t>();
        AscendC::LocalTensor<uint16_t> keyStream = r1g1.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp1 = r0g0.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp2 = r0g1.Get<uint16_t>();
        XorNew(outLocal, inLocal, keyStream, tmp1, tmp2, tile_length / 2);
        outQueue.EnQue(outLocal);
        inQueue.FreeTensor(inLocal);
    }
    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<uint8_t> outLocal = outQueue.DeQue<uint8_t>();
        AscendC::DataCopy(outGm[offset], outLocal, tile_length);
        outQueue.FreeTensor(outLocal);
    }
    __aicore__ inline void GenerateCounterSubBytes(const uint32_t* w, uint32_t start_block_idx, uint32_t cur_block_num)
    {
        AscendC::LocalTensor<uint8_t> statesDst = r0g0.Get<uint8_t>();
        AscendC::LocalTensor<uint32_t> counter = r1g0.Get<uint32_t>();
        AscendC::LocalTensor<uint32_t> ws = r1g1.Get<uint32_t>();
        AscendC::LocalTensor<uint32_t> tmp1 = r2g0.Get<uint32_t>();
        AscendC::LocalTensor<uint32_t> tmp2 = r2g1.Get<uint32_t>();
        AscendC::LocalTensor<uint32_t> srcOffset = subBytesBuf.Get<uint32_t>();
        const AscendC::LocalTensor<uint32_t>& statesOffset00 = srcOffset;
        const AscendC::LocalTensor<uint32_t>& statesOffset01 = srcOffset[1 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset02 = srcOffset[2 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset03 = srcOffset[3 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset11 = srcOffset[4 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset12 = srcOffset[5 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset13 = srcOffset[6 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset10 = srcOffset[7 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset22 = srcOffset[8 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset23 = srcOffset[9 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset20 = srcOffset[10 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset21 = srcOffset[11 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset33 = srcOffset[12 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset30 = srcOffset[13 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset31 = srcOffset[14 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& statesOffset32 = srcOffset[15 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& states03 = tmp1;
        const AscendC::LocalTensor<uint32_t>& states13 = tmp1[1 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& states23 = tmp1[2 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& states33 = tmp1[3 * cur_block_num];
        const AscendC::LocalTensor<uint32_t>& tmpMask = tmp2;
        const AscendC::LocalTensor<half>& statesDstHalf = tmp1.ReinterpretCast<half>();
        const int32_t firstValue = static_cast<int32_t>(start_block_idx) + 2;
        AscendC::CreateVecIndex(counter.ReinterpretCast<int32_t>(), firstValue, cur_block_num);
        AscendC::Duplicate(ws, bswap32(w[3]), cur_block_num);
        Xor32(counter, counter, ws, tmp1, tmp2, cur_block_num);
        AscendC::ShiftRight(states03, counter, 23u, cur_block_num);
        AscendC::ShiftRight(states13, counter, 15u, cur_block_num);
        AscendC::ShiftRight(states23, counter, 7u, cur_block_num);
        AscendC::ShiftLeft(states33, counter, 1u, cur_block_num);
        AscendC::Duplicate(tmpMask, 0x1FEu, cur_block_num);
        And32(statesOffset03, states03, tmpMask, cur_block_num);
        And32(statesOffset13, states13, tmpMask, cur_block_num);
        And32(statesOffset23, states23, tmpMask, cur_block_num);
        And32(statesOffset33, states33, tmpMask, cur_block_num);
        const uint8_t* wb = (const uint8_t*)w;
        AscendC::Duplicate(statesOffset00, 2u * (local_nonce[0] ^ wb[0]), cur_block_num);
        AscendC::Duplicate(statesOffset10, 2u * (local_nonce[1] ^ wb[1]), cur_block_num);
        AscendC::Duplicate(statesOffset20, 2u * (local_nonce[2] ^ wb[2]), cur_block_num);
        AscendC::Duplicate(statesOffset30, 2u * (local_nonce[3] ^ wb[3]), cur_block_num);
        AscendC::Duplicate(statesOffset01, 2u * (local_nonce[4] ^ wb[4]), cur_block_num);
        AscendC::Duplicate(statesOffset11, 2u * (local_nonce[5] ^ wb[5]), cur_block_num);
        AscendC::Duplicate(statesOffset21, 2u * (local_nonce[6] ^ wb[6]), cur_block_num);
        AscendC::Duplicate(statesOffset31, 2u * (local_nonce[7] ^ wb[7]), cur_block_num);
        AscendC::Duplicate(statesOffset02, 2u * (local_nonce[8] ^ wb[8]), cur_block_num);
        AscendC::Duplicate(statesOffset12, 2u * (local_nonce[9] ^ wb[9]), cur_block_num);
        AscendC::Duplicate(statesOffset22, 2u * (local_nonce[10] ^ wb[10]), cur_block_num);
        AscendC::Duplicate(statesOffset32, 2u * (local_nonce[11] ^ wb[11]), cur_block_num);
        AscendC::Gather(statesDstHalf, sBoxHalf, srcOffset, 0, 16 * cur_block_num);
        AscendC::Cast(statesDst, statesDstHalf, AscendC::RoundMode::CAST_RINT, 16 * cur_block_num);
    }
    __aicore__ inline void MixColumns()
    {
        AscendC::LocalTensor<uint16_t> states = r0g0.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> xtime = r0g1.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp3 = r1g0.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp4 = r1g1.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp1 = r2g0.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp2 = r2g1.Get<uint16_t>();
        const AscendC::LocalTensor<uint16_t>& const0x80 = xtime;
        const AscendC::LocalTensor<uint16_t>& b = tmp2;
        const AscendC::LocalTensor<uint16_t>& a1 = tmp4;
        const AscendC::LocalTensor<uint16_t>& b1 = tmp3;
        const AscendC::LocalTensor<uint16_t>& b2 = xtime;
        const AscendC::LocalTensor<uint16_t>& const0x1B = tmp1;
        const AscendC::LocalTensor<uint16_t>& b3 = tmp3;
        const AscendC::LocalTensor<uint16_t>& a2 = xtime;
        const AscendC::LocalTensor<uint16_t>& y = tmp4;
        const AscendC::LocalTensor<uint16_t>& mid = tmp3;
        AscendC::Duplicate(const0x80, static_cast<uint16_t>(0x8080), tile_length / 2);
        AscendC::And(b, states, const0x80, tile_length / 2);
        const AscendC::LocalTensor<int16_t>& a1S = a1.ReinterpretCast<int16_t>();
        const AscendC::LocalTensor<int16_t>& statesS = states.ReinterpretCast<int16_t>();
        const AscendC::LocalTensor<int16_t>& bS = b.ReinterpretCast<int16_t>();
        AscendC::Sub(a1S, statesS, bS, tile_length / 2);
        AscendC::ShiftRight(b1, b, static_cast<uint16_t>(7), tile_length / 2);
        const AscendC::LocalTensor<int16_t>& b2S = b2.ReinterpretCast<int16_t>();
        const AscendC::LocalTensor<int16_t>& b1S = b1.ReinterpretCast<int16_t>();
        AscendC::Sub(b2S, bS, b1S, tile_length / 2);
        AscendC::Duplicate(const0x1B, static_cast<uint16_t>(0x1B1B), tile_length / 2);
        AscendC::And(b3, b2, const0x1B, tile_length / 2);
        AscendC::ShiftLeft(a2, a1, static_cast<uint16_t>(1), tile_length / 2);
        XorNew(xtime, b3, a2, tmp1, tmp2, tile_length / 2);
        XorNew(y, states[2 * block_num], xtime, tmp1, tmp2, 6 * block_num);
        XorNew(y[6 * block_num], states, xtime[6 * block_num], tmp1, tmp2, 2 * block_num);
        XorNew(mid, y, states[6 * block_num], tmp1, tmp2, 2 * block_num);
        XorNew(mid[2 * block_num], y[2 * block_num], states, tmp1, tmp2, 6 * block_num);
        XorNew(states, y[2 * block_num], mid, tmp1, tmp2, 6 * block_num);
        XorNew(states[6 * block_num], y, mid[6 * block_num], tmp1, tmp2, 2 * block_num);
    }
    __aicore__ inline void AddRoundKeyShiftRows(const uint32_t* w)
    {
        AscendC::LocalTensor<uint16_t> states = r0g0.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> rdKey = r0g1.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp1 = r2g0.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp2 = r2g1.Get<uint16_t>();
        const AscendC::LocalTensor<uint16_t>& rdKey00 = rdKey;
        const AscendC::LocalTensor<uint16_t>& rdKey01 = rdKey[1 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey02 = rdKey[2 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey03 = rdKey[3 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey10 = rdKey[4 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey11 = rdKey[5 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey12 = rdKey[6 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey13 = rdKey[7 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey20 = rdKey[8 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey21 = rdKey[9 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey22 = rdKey[10 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey23 = rdKey[11 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey30 = rdKey[12 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey31 = rdKey[13 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey32 = rdKey[14 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey33 = rdKey[15 * block_num / 2];
        const uint8_t* wb = (const uint8_t*)w;
        AscendC::Duplicate(rdKey00, static_cast<uint16_t>(0x101u * wb[0]), block_num / 2);
        AscendC::Duplicate(rdKey10, static_cast<uint16_t>(0x101u * wb[1]), block_num / 2);
        AscendC::Duplicate(rdKey20, static_cast<uint16_t>(0x101u * wb[2]), block_num / 2);
        AscendC::Duplicate(rdKey30, static_cast<uint16_t>(0x101u * wb[3]), block_num / 2);
        AscendC::Duplicate(rdKey01, static_cast<uint16_t>(0x101u * wb[4]), block_num / 2);
        AscendC::Duplicate(rdKey11, static_cast<uint16_t>(0x101u * wb[5]), block_num / 2);
        AscendC::Duplicate(rdKey21, static_cast<uint16_t>(0x101u * wb[6]), block_num / 2);
        AscendC::Duplicate(rdKey31, static_cast<uint16_t>(0x101u * wb[7]), block_num / 2);
        AscendC::Duplicate(rdKey02, static_cast<uint16_t>(0x101u * wb[8]), block_num / 2);
        AscendC::Duplicate(rdKey12, static_cast<uint16_t>(0x101u * wb[9]), block_num / 2);
        AscendC::Duplicate(rdKey22, static_cast<uint16_t>(0x101u * wb[10]), block_num / 2);
        AscendC::Duplicate(rdKey32, static_cast<uint16_t>(0x101u * wb[11]), block_num / 2);
        AscendC::Duplicate(rdKey03, static_cast<uint16_t>(0x101u * wb[12]), block_num / 2);
        AscendC::Duplicate(rdKey13, static_cast<uint16_t>(0x101u * wb[13]), block_num / 2);
        AscendC::Duplicate(rdKey23, static_cast<uint16_t>(0x101u * wb[14]), block_num / 2);
        AscendC::Duplicate(rdKey33, static_cast<uint16_t>(0x101u * wb[15]), block_num / 2);
        AscendC::Or(tmp1, states, rdKey, tile_length / 2);
        AscendC::And(tmp2, states, rdKey, tile_length / 2);
        const AscendC::LocalTensor<int16_t>& statesS = states.ReinterpretCast<int16_t>();
        const AscendC::LocalTensor<int16_t>& tmp1S = tmp1.ReinterpretCast<int16_t>();
        const AscendC::LocalTensor<int16_t>& tmp2S = tmp2.ReinterpretCast<int16_t>();
        AscendC::Sub(statesS, tmp1S, tmp2S, 4 * block_num / 2);
        AscendC::Sub(statesS[4 * block_num / 2], tmp1S[5 * block_num / 2], tmp2S[5 * block_num / 2], 3 * block_num / 2);
        AscendC::Sub(
            statesS[13 * block_num / 2], tmp1S[12 * block_num / 2], tmp2S[12 * block_num / 2], 3 * block_num / 2);
        AscendC::Sub(
            statesS[8 * block_num / 2], tmp1S[10 * block_num / 2], tmp2S[10 * block_num / 2], 2 * block_num / 2);
        AscendC::Sub(
            statesS[10 * block_num / 2], tmp1S[8 * block_num / 2], tmp2S[8 * block_num / 2], 2 * block_num / 2);
        AscendC::Sub(statesS[7 * block_num / 2], tmp1S[4 * block_num / 2], tmp2S[4 * block_num / 2], block_num / 2);
        AscendC::Sub(statesS[12 * block_num / 2], tmp1S[15 * block_num / 2], tmp2S[15 * block_num / 2], block_num / 2);
    }
    __aicore__ inline void SubBytes()
    {
        AscendC::LocalTensor<uint8_t> states = r0g0.Get<uint8_t>();
        AscendC::LocalTensor<uint32_t> srcOffset = subBytesBuf.Get<uint32_t>();
        AscendC::LocalTensor<half> states16 = r1g0.Get<half>();
        states16.SetSize(2 * tile_length);
        AscendC::LocalTensor<half> offset = r2g0.Get<half>();
        AscendC::Cast(states16, states, AscendC::RoundMode::CAST_NONE, tile_length);
        AscendC::Muls(offset, states16, static_cast<half>(2), tile_length);
        AscendC::Cast(srcOffset.ReinterpretCast<int32_t>(), offset, AscendC::RoundMode::CAST_RINT, tile_length);
        AscendC::Gather(offset, sBoxHalf, srcOffset, 0, tile_length);
        AscendC::Cast(states, offset, AscendC::RoundMode::CAST_RINT, tile_length);
    }
    __aicore__ inline void AddRoundKeyFinal(const uint32_t* w)
    {
        AscendC::LocalTensor<uint16_t> states = r0g0.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> rdKey = r0g1.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp1 = r2g0.Get<uint16_t>();
        AscendC::LocalTensor<uint16_t> tmp2 = r2g1.Get<uint16_t>();
        const AscendC::LocalTensor<uint16_t>& rdKey00 = rdKey;
        const AscendC::LocalTensor<uint16_t>& rdKey01 = rdKey[1 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey02 = rdKey[2 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey03 = rdKey[3 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey10 = rdKey[4 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey11 = rdKey[5 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey12 = rdKey[6 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey13 = rdKey[7 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey20 = rdKey[8 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey21 = rdKey[9 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey22 = rdKey[10 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey23 = rdKey[11 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey30 = rdKey[12 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey31 = rdKey[13 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey32 = rdKey[14 * block_num / 2];
        const AscendC::LocalTensor<uint16_t>& rdKey33 = rdKey[15 * block_num / 2];
        const uint8_t* wb = (const uint8_t*)w;
        AscendC::Duplicate(rdKey00, static_cast<uint16_t>(0x101u * wb[0]), block_num / 2);
        AscendC::Duplicate(rdKey10, static_cast<uint16_t>(0x101u * wb[1]), block_num / 2);
        AscendC::Duplicate(rdKey20, static_cast<uint16_t>(0x101u * wb[2]), block_num / 2);
        AscendC::Duplicate(rdKey30, static_cast<uint16_t>(0x101u * wb[3]), block_num / 2);
        AscendC::Duplicate(rdKey01, static_cast<uint16_t>(0x101u * wb[4]), block_num / 2);
        AscendC::Duplicate(rdKey11, static_cast<uint16_t>(0x101u * wb[5]), block_num / 2);
        AscendC::Duplicate(rdKey21, static_cast<uint16_t>(0x101u * wb[6]), block_num / 2);
        AscendC::Duplicate(rdKey31, static_cast<uint16_t>(0x101u * wb[7]), block_num / 2);
        AscendC::Duplicate(rdKey02, static_cast<uint16_t>(0x101u * wb[8]), block_num / 2);
        AscendC::Duplicate(rdKey12, static_cast<uint16_t>(0x101u * wb[9]), block_num / 2);
        AscendC::Duplicate(rdKey22, static_cast<uint16_t>(0x101u * wb[10]), block_num / 2);
        AscendC::Duplicate(rdKey32, static_cast<uint16_t>(0x101u * wb[11]), block_num / 2);
        AscendC::Duplicate(rdKey03, static_cast<uint16_t>(0x101u * wb[12]), block_num / 2);
        AscendC::Duplicate(rdKey13, static_cast<uint16_t>(0x101u * wb[13]), block_num / 2);
        AscendC::Duplicate(rdKey23, static_cast<uint16_t>(0x101u * wb[14]), block_num / 2);
        AscendC::Duplicate(rdKey33, static_cast<uint16_t>(0x101u * wb[15]), block_num / 2);
        XorNew(states, states, rdKey, tmp1, tmp2, tile_length / 2);
    }
    __aicore__ inline void Trans()
    {
        AscendC::LocalTensor<uint8_t> states = r0g0.Get<uint8_t>();
        AscendC::LocalTensor<uint8_t> keyStream = r1g1.Get<uint8_t>();
        AscendC::LocalTensor<half> statesPadded = transBuf.Get<half>();
        const uint32_t stride = block_num + HALF_ROW / 2;
        const AscendC::LocalTensor<half>& src00 = statesPadded;
        const AscendC::LocalTensor<half>& src01 = statesPadded[1 * stride];
        const AscendC::LocalTensor<half>& src02 = statesPadded[2 * stride];
        const AscendC::LocalTensor<half>& src03 = statesPadded[3 * stride];
        const AscendC::LocalTensor<half>& src10 = statesPadded[4 * stride];
        const AscendC::LocalTensor<half>& src11 = statesPadded[5 * stride];
        const AscendC::LocalTensor<half>& src12 = statesPadded[6 * stride];
        const AscendC::LocalTensor<half>& src13 = statesPadded[7 * stride];
        const AscendC::LocalTensor<half>& src20 = statesPadded[8 * stride];
        const AscendC::LocalTensor<half>& src21 = statesPadded[9 * stride];
        const AscendC::LocalTensor<half>& src22 = statesPadded[10 * stride];
        const AscendC::LocalTensor<half>& src23 = statesPadded[11 * stride];
        const AscendC::LocalTensor<half>& src30 = statesPadded[12 * stride];
        const AscendC::LocalTensor<half>& src31 = statesPadded[13 * stride];
        const AscendC::LocalTensor<half>& src32 = statesPadded[14 * stride];
        const AscendC::LocalTensor<half>& src33 = statesPadded[15 * stride];
        const AscendC::LocalTensor<half>& transDst = states.ReinterpretCast<half>();
        AscendC::Cast(src00, states, AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src01, states[1 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src02, states[2 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src03, states[3 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src10, states[4 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src11, states[5 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src12, states[6 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src13, states[7 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src20, states[8 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src21, states[9 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src22, states[10 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src23, states[11 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src30, states[12 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src31, states[13 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src32, states[14 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        AscendC::Cast(src33, states[15 * block_num], AscendC::RoundMode::CAST_NONE, block_num);
        uint64_t dstLocalList[16] = {
            (uint64_t)transDst.GetPhyAddr(),          (uint64_t)transDst[1 * 16].GetPhyAddr(),
            (uint64_t)transDst[2 * 16].GetPhyAddr(),  (uint64_t)transDst[3 * 16].GetPhyAddr(),
            (uint64_t)transDst[4 * 16].GetPhyAddr(),  (uint64_t)transDst[5 * 16].GetPhyAddr(),
            (uint64_t)transDst[6 * 16].GetPhyAddr(),  (uint64_t)transDst[7 * 16].GetPhyAddr(),
            (uint64_t)transDst[8 * 16].GetPhyAddr(),  (uint64_t)transDst[9 * 16].GetPhyAddr(),
            (uint64_t)transDst[10 * 16].GetPhyAddr(), (uint64_t)transDst[11 * 16].GetPhyAddr(),
            (uint64_t)transDst[12 * 16].GetPhyAddr(), (uint64_t)transDst[13 * 16].GetPhyAddr(),
            (uint64_t)transDst[14 * 16].GetPhyAddr(), (uint64_t)transDst[15 * 16].GetPhyAddr(),
        };
        uint64_t srcLocalList[16] = {
            (uint64_t)src00.GetPhyAddr(), (uint64_t)src10.GetPhyAddr(), (uint64_t)src20.GetPhyAddr(),
            (uint64_t)src30.GetPhyAddr(), (uint64_t)src01.GetPhyAddr(), (uint64_t)src11.GetPhyAddr(),
            (uint64_t)src21.GetPhyAddr(), (uint64_t)src31.GetPhyAddr(), (uint64_t)src02.GetPhyAddr(),
            (uint64_t)src12.GetPhyAddr(), (uint64_t)src22.GetPhyAddr(), (uint64_t)src32.GetPhyAddr(),
            (uint64_t)src03.GetPhyAddr(), (uint64_t)src13.GetPhyAddr(), (uint64_t)src23.GetPhyAddr(),
            (uint64_t)src33.GetPhyAddr(),
        };
        AscendC::TransDataTo5HDParams nchwconvParams;
        nchwconvParams.repeatTimes = (block_num + 15) / 16;
        nchwconvParams.dstRepStride = 16;
        nchwconvParams.srcRepStride = 1;
        AscendC::TransDataTo5HD<half>(dstLocalList, srcLocalList, nchwconvParams);
        AscendC::Cast(keyStream, transDst, AscendC::RoundMode::CAST_RINT, tile_length);
    }

private:
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::TBufPool<AscendC::TPosition::VECCALC, 8> bufPool12, bufPool1, bufPool2, bufPool3;
    AscendC::TBufPool<AscendC::TPosition::VECCALC> bufPoolSubBytes, bufPoolTrans;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sBoxBuf, r0g0, r0g1, r1g0, r1g1, r2g0, r2g1, subBytesBuf, transBuf;
    AscendC::GlobalTensor<uint8_t> inGm, outGm;
    uint32_t local_rd_key[44];
    uint8_t local_nonce[12];
    AscendC::LocalTensor<half> sBoxHalf;
    uint32_t block_num;
    uint32_t tile_length;
    uint32_t core_start_byte;
    uint32_t core_end_byte;
    uint32_t global_block_idx;
};

// AES-128-GCM precompute kernel class
class AES128GCMPrecompute {
public:
    __aicore__ inline AES128GCMPrecompute() {}
    __aicore__ inline void Init(
        GM_ADDR __restrict__ precomputed_gm, const __gm__ Aes128GcmTilingData* __restrict__ ctx_ptr,
        AscendC::TPipe* pipe)
    {
        precomputedGm.SetGlobalBuffer((__gm__ uint8_t*)precomputed_gm, 64);
        for (int i = 0; i < 44; i++)
            ctx.rd_key[i] = ctx_ptr->rd_key[i];
        for (int i = 0; i < 12; i++)
            ctx.nonce[i] = ctx_ptr->nonce[i];
        ctx.totalDataSize = ctx_ptr->totalDataSize;
        ctx.aad_len = ctx_ptr->aad_len;
        for (int i = 0; i < 32; i++)
            ctx.aad[i] = ctx_ptr->aad[i];
        ctx.numCores = ctx_ptr->numCores;
        ctx.ghashCoreNum = ctx_ptr->ghashCoreNum;
        pipe->InitBufPool(bufPool, 2 * HALF_ROW);
        pipe->InitBuffer(workBuf, 64);
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<uint8_t> workLocal = workBuf.Get<uint8_t>();
        uint8_t zero_block[16] = {0};
        uint8_t h_result[16];
        aes_encrypt_single_block((const uint8_t*)ctx.rd_key, zero_block, h_result, ctx.rd_key);
        uint8_t j0[16];
        for (int i = 0; i < 12; i++)
            j0[i] = ctx.nonce[i];
        j0[12] = j0[13] = j0[14] = 0;
        j0[15] = 1;
        uint8_t enc_j0_result[16];
        aes_encrypt_single_block((const uint8_t*)ctx.rd_key, j0, enc_j0_result, ctx.rd_key);
        for (int i = 0; i < 16; i++)
            workLocal.SetValue(i, h_result[i]);
        for (int i = 0; i < 16; i++)
            workLocal.SetValue(32 + i, enc_j0_result[i]);
        AscendC::DataCopy(precomputedGm, workLocal, 64);
    }

private:
    AscendC::GlobalTensor<uint8_t> precomputedGm;
    Aes128GcmTilingData ctx;
    AscendC::TBufPool<AscendC::TPosition::VECCALC> bufPool;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workBuf;
};

// AES-128-GCM GHASH parallel kernel class
class AES128GCMGhashParallel {
public:
    __aicore__ inline AES128GCMGhashParallel() {}
    __aicore__ inline void Init(
        GM_ADDR __restrict__ out, GM_ADDR __restrict__ ghash_interm_gm, GM_ADDR __restrict__ precomputed_gm,
        const __gm__ Aes128GcmTilingData* __restrict__ ctx_ptr, AscendC::TPipe* pipe)
    {
        uint32_t core_idx = AscendC::GetBlockIdx();
        uint32_t ghashCoreNum = ctx_ptr->ghashCoreNum;
        uint32_t total_blocks = ctx_ptr->totalDataSize / 16;
        uint32_t blocks_per_core = total_blocks / ghashCoreNum;
        uint32_t remainder = total_blocks % ghashCoreNum;
        uint32_t start_block = core_idx * blocks_per_core + (core_idx < remainder ? core_idx : remainder);
        uint32_t end_block = start_block + blocks_per_core + (core_idx < remainder ? 1 : 0);
        if (core_idx >= ghashCoreNum) {
            num_blocks = 0;
            len = 0;
            start_offset = 0;
        } else {
            num_blocks = end_block - start_block;
            start_offset = start_block * 16;
            len = num_blocks * 16;
        }
        outGm.SetGlobalBuffer((__gm__ uint8_t*)out + start_offset, len);
        ghashIntermGm.SetGlobalBuffer((__gm__ uint8_t*)ghash_interm_gm + core_idx * 32, 32);
        precomputedGm.SetGlobalBuffer((__gm__ uint8_t*)precomputed_gm, 64);
        for (int i = 0; i < 44; i++)
            ctx.rd_key[i] = ctx_ptr->rd_key[i];
        for (int i = 0; i < 12; i++)
            ctx.nonce[i] = ctx_ptr->nonce[i];
        ctx.totalDataSize = ctx_ptr->totalDataSize;
        ctx.aad_len = ctx_ptr->aad_len;
        for (int i = 0; i < 32; i++)
            ctx.aad[i] = ctx_ptr->aad[i];
        ctx.numCores = ctx_ptr->numCores;
        ctx.ghashCoreNum = ctx_ptr->ghashCoreNum;
        this->num_blocks = num_blocks;
        this->len = len;
        pipe->InitBufPool(bufPool, 2 * ONE_RANK);
        uint32_t cipher_buf_len = (len + 31) / 32 * 32;
        if (cipher_buf_len == 0)
            cipher_buf_len = 32;
        pipe->InitBuffer(cipherQueue, 1, cipher_buf_len);
        pipe->InitBuffer(ghashBuf, 32);
        pipe->InitBuffer(hBuf, 32);
        pipe->InitBuffer(tmpBuf, 32);
        pipe->InitBuffer(preBuf, 64);
    }
    __aicore__ inline void Process()
    {
        if (num_blocks == 0)
            return;
        AscendC::LocalTensor<uint8_t> preLocal = preBuf.Get<uint8_t>();
        AscendC::DataCopy(preLocal, precomputedGm, 64);
        AscendC::LocalTensor<uint8_t> hLocal = hBuf.Get<uint8_t>();
        for (int i = 0; i < 16; i++)
            hLocal.SetValue(i, preLocal.GetValue(i));
        CopyIn();
        ComputeGhash(hLocal);
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<uint8_t> cipherLocal = cipherQueue.AllocTensor<uint8_t>();
        uint32_t copy_len = (len + 31) / 32 * 32;
        AscendC::DataCopy(cipherLocal, outGm, copy_len);
        cipherQueue.EnQue(cipherLocal);
    }
    __aicore__ inline void ComputeGhash(AscendC::LocalTensor<uint8_t>& hLocal)
    {
        AscendC::LocalTensor<uint8_t> cipherLocal = cipherQueue.DeQue<uint8_t>();
        AscendC::LocalTensor<uint8_t> ghashLocal = ghashBuf.Get<uint8_t>();
        AscendC::LocalTensor<uint8_t> tmpLocal = tmpBuf.Get<uint8_t>();
        for (int i = 0; i < 16; i++)
            ghashLocal.SetValue(i, 0);
        for (uint32_t i = 0; i < num_blocks; i++) {
            for (int j = 0; j < 16; j++) {
                uint8_t val = ghashLocal.GetValue(j) ^ cipherLocal.GetValue(i * 16 + j);
                ghashLocal.SetValue(j, val);
            }
            GF128MulBigEndian(ghashLocal, hLocal, tmpLocal);
        }
        cipherQueue.FreeTensor(cipherLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<uint8_t> ghashLocal = ghashBuf.Get<uint8_t>();
        AscendC::DataCopy(ghashIntermGm, ghashLocal, 32);
    }
    AscendC::GlobalTensor<uint8_t> outGm, ghashIntermGm, precomputedGm;
    Aes128GcmTilingData ctx;
    uint32_t num_blocks, len, start_offset;
    AscendC::TBufPool<AscendC::TPosition::VECCALC> bufPool;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> cipherQueue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> ghashBuf, hBuf, tmpBuf, preBuf;
};

// AES-128-GCM merge tag kernel class
class AES128GMMergeTag {
public:
    __aicore__ inline AES128GMMergeTag() {}
    __aicore__ inline void Init(
        GM_ADDR __restrict__ out, GM_ADDR __restrict__ ghash_interm_gm, GM_ADDR __restrict__ precomputed_gm,
        const __gm__ Aes128GcmTilingData* __restrict__ ctx_ptr, AscendC::TPipe* pipe)
    {
        outGm.SetGlobalBuffer((__gm__ uint8_t*)out, ctx_ptr->totalDataSize + GCM_TAG_SIZE);
        tagGm.SetGlobalBuffer((__gm__ uint8_t*)out + ctx_ptr->totalDataSize, GCM_TAG_SIZE);
        ghashIntermGm.SetGlobalBuffer((__gm__ uint8_t*)ghash_interm_gm, ctx_ptr->ghashCoreNum * 32);
        precomputedGm.SetGlobalBuffer((__gm__ uint8_t*)precomputed_gm, 64);
        for (int i = 0; i < 44; i++)
            ctx.rd_key[i] = ctx_ptr->rd_key[i];
        for (int i = 0; i < 12; i++)
            ctx.nonce[i] = ctx_ptr->nonce[i];
        ctx.totalDataSize = ctx_ptr->totalDataSize;
        ctx.aad_len = ctx_ptr->aad_len;
        for (int i = 0; i < 32; i++)
            ctx.aad[i] = ctx_ptr->aad[i];
        ctx.numCores = ctx_ptr->numCores;
        ctx.ghashCoreNum = ctx_ptr->ghashCoreNum;
        pipe->InitBufPool(bufPool, 2 * ONE_RANK);
        pipe->InitBuffer(tagQueue, 1, 32);
        pipe->InitBuffer(ghashIntermQueue, 1, ctx.ghashCoreNum * 32);
        pipe->InitBuffer(hBuf, 32);
        pipe->InitBuffer(tagBuf, 32);
        pipe->InitBuffer(encJ0Buf, 32);
        pipe->InitBuffer(tmpBuf, 32);
        pipe->InitBuffer(hPowBuf, 32);
        pipe->InitBuffer(preBuf, 64);
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<uint8_t> preLocal = preBuf.Get<uint8_t>();
        AscendC::DataCopy(preLocal, precomputedGm, 64);
        AscendC::LocalTensor<uint8_t> hLocal = hBuf.Get<uint8_t>();
        AscendC::LocalTensor<uint8_t> encJ0Local = encJ0Buf.Get<uint8_t>();
        for (int i = 0; i < 16; i++)
            hLocal.SetValue(i, preLocal.GetValue(i));
        for (int i = 0; i < 16; i++)
            encJ0Local.SetValue(i, preLocal.GetValue(32 + i));
        if (ctx.totalDataSize != 0)
            CopyInInterm();
        ProcessAAD(hLocal);
        MergeGhashIntermediate(hLocal);
        ProcessLength(hLocal);
        ComputeTag(encJ0Local);
        CopyOut();
    }

private:
    __aicore__ inline void CopyInInterm()
    {
        AscendC::LocalTensor<uint8_t> ghashIntermLocal = ghashIntermQueue.AllocTensor<uint8_t>();
        AscendC::DataCopy(ghashIntermLocal, ghashIntermGm, ctx.ghashCoreNum * 32);
        ghashIntermQueue.EnQue(ghashIntermLocal);
    }
    __aicore__ inline void ProcessAAD(AscendC::LocalTensor<uint8_t>& hLocal)
    {
        AscendC::LocalTensor<uint8_t> tagLocal = tagBuf.Get<uint8_t>();
        AscendC::LocalTensor<uint8_t> tmpLocal = tmpBuf.Get<uint8_t>();
        for (int i = 0; i < 16; i++)
            tagLocal.SetValue(i, 0);
        uint32_t len = ctx.aad_len;
        uint32_t offset = 0;
        while (len >= 16) {
            for (int i = 0; i < 16; i++) {
                uint8_t val = tagLocal.GetValue(i) ^ ctx.aad[offset + i];
                tagLocal.SetValue(i, val);
            }
            GF128MulBigEndian(tagLocal, hLocal, tmpLocal);
            offset += 16;
            len -= 16;
        }
        if (len > 0) {
            uint8_t lastBlock[16] = {0};
            for (uint32_t i = 0; i < len; i++)
                lastBlock[i] = ctx.aad[offset + i];
            for (int i = 0; i < 16; i++) {
                uint8_t val = tagLocal.GetValue(i) ^ lastBlock[i];
                tagLocal.SetValue(i, val);
            }
            GF128MulBigEndian(tagLocal, hLocal, tmpLocal);
        }
    }
    __aicore__ inline void MergeGhashIntermediate(AscendC::LocalTensor<uint8_t>& hLocal)
    {
        uint32_t total_blocks = ctx.totalDataSize / 16;
        if (total_blocks == 0)
            return;
        AscendC::LocalTensor<uint8_t> ghashIntermLocal = ghashIntermQueue.DeQue<uint8_t>();
        AscendC::LocalTensor<uint8_t> tagLocal = tagBuf.Get<uint8_t>();
        AscendC::LocalTensor<uint8_t> hPowLocal = hPowBuf.Get<uint8_t>();
        AscendC::LocalTensor<uint8_t> tmpLocal = tmpBuf.Get<uint8_t>();
        uint32_t ghashCoreNum = ctx.ghashCoreNum;
        uint32_t blocks_per_core = total_blocks / ghashCoreNum;
        uint32_t remainder = total_blocks % ghashCoreNum;
        uint32_t max_blocks = blocks_per_core + (remainder > 0 ? 1 : 0);
        for (int i = 0; i < 16; i++)
            hPowLocal.SetValue(i, hLocal.GetValue(i));
        for (uint32_t i = 1; i < max_blocks; i++) {
            GF128MulBigEndian(hPowLocal, hLocal, tmpLocal);
        }
        for (uint32_t i = 0; i < ghashCoreNum; i++) {
            GF128MulBigEndian(tagLocal, hPowLocal, tmpLocal);
            for (int j = 0; j < 16; j++) {
                uint8_t val = tagLocal.GetValue(j) ^ ghashIntermLocal.GetValue(i * 32 + j);
                tagLocal.SetValue(j, val);
            }
        }
        ghashIntermQueue.FreeTensor(ghashIntermLocal);
    }
    __aicore__ inline void ProcessLength(AscendC::LocalTensor<uint8_t>& hLocal)
    {
        AscendC::LocalTensor<uint8_t> tagLocal = tagBuf.Get<uint8_t>();
        AscendC::LocalTensor<uint8_t> tmpLocal = tmpBuf.Get<uint8_t>();
        uint8_t lenBlock[16];
        uint64_t aadBits = (uint64_t)ctx.aad_len * 8;
        uint64_t cipherBits = (uint64_t)ctx.totalDataSize * 8;
        for (int i = 0; i < 8; i++)
            lenBlock[i] = (aadBits >> (56 - i * 8)) & 0xFF;
        for (int i = 0; i < 8; i++)
            lenBlock[8 + i] = (cipherBits >> (56 - i * 8)) & 0xFF;
        for (int i = 0; i < 16; i++) {
            uint8_t val = tagLocal.GetValue(i) ^ lenBlock[i];
            tagLocal.SetValue(i, val);
        }
        GF128MulBigEndian(tagLocal, hLocal, tmpLocal);
    }
    __aicore__ inline void ComputeTag(AscendC::LocalTensor<uint8_t>& encJ0Local)
    {
        AscendC::LocalTensor<uint8_t> tagLocal = tagBuf.Get<uint8_t>();
        for (int i = 0; i < 16; i++) {
            uint8_t val = tagLocal.GetValue(i) ^ encJ0Local.GetValue(i);
            tagLocal.SetValue(i, val);
        }
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<uint8_t> tagLocal = tagBuf.Get<uint8_t>();
        AscendC::LocalTensor<uint8_t> tagOut = tagQueue.AllocTensor<uint8_t>();
        for (int i = 0; i < GCM_TAG_SIZE; i++)
            tagOut.SetValue(i, tagLocal.GetValue(i));
        tagQueue.EnQue(tagOut);
        AscendC::LocalTensor<uint8_t> finalTag = tagQueue.DeQue<uint8_t>();
        AscendC::DataCopy(tagGm, finalTag, GCM_TAG_SIZE);
        tagQueue.FreeTensor(finalTag);
    }
    AscendC::GlobalTensor<uint8_t> outGm, tagGm, ghashIntermGm, precomputedGm;
    Aes128GcmTilingData ctx;
    AscendC::TBufPool<AscendC::TPosition::VECCALC> bufPool;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> ghashIntermQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> tagQueue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> hBuf, tagBuf, encJ0Buf, tmpBuf, hPowBuf, preBuf;
};

// Kernel entry points
extern "C" __global__ __aicore__ void aes_128_gcm_precompute(
    GM_ADDR __restrict__ precomputed_gm, GM_ADDR __restrict__ ctx_addr)
{
    if (AscendC::GetBlockIdx() == 0) {
        const __gm__ Aes128GcmTilingData* ctx_ptr = reinterpret_cast<const __gm__ Aes128GcmTilingData*>(ctx_addr);
        AES128GCMPrecompute op;
        AscendC::TPipe pipe;
        op.Init(precomputed_gm, ctx_ptr, &pipe);
        op.Process();
    }
}

extern "C" __global__ __aicore__ void aes_128_gcm_encrypt(
    uint32_t totalDataSize, uint32_t numCores, GM_ADDR __restrict__ in, GM_ADDR __restrict__ out,
    GM_ADDR __restrict__ ctx_addr)
{
    const __gm__ Aes128GcmTilingData* ctx_ptr = reinterpret_cast<const __gm__ Aes128GcmTilingData*>(ctx_addr);
    AES128GCMEncrypt op;
    AscendC::TPipe pipe;
    op.Init(totalDataSize, numCores, in, out, ctx_ptr, &pipe);
    op.Process();
}

extern "C" __global__ __aicore__ void aes_128_gcm_ghash_parallel(
    GM_ADDR __restrict__ out, GM_ADDR __restrict__ ghash_interm_gm, GM_ADDR __restrict__ precomputed_gm,
    GM_ADDR __restrict__ ctx_addr)
{
    const __gm__ Aes128GcmTilingData* ctx_ptr = reinterpret_cast<const __gm__ Aes128GcmTilingData*>(ctx_addr);
    AES128GCMGhashParallel op;
    AscendC::TPipe pipe;
    op.Init(out, ghash_interm_gm, precomputed_gm, ctx_ptr, &pipe);
    op.Process();
}

extern "C" __global__ __aicore__ void aes_128_gcm_merge_tag(
    GM_ADDR __restrict__ out, GM_ADDR __restrict__ ghash_interm_gm, GM_ADDR __restrict__ precomputed_gm,
    GM_ADDR __restrict__ ctx_addr)
{
    if (AscendC::GetBlockIdx() == 0) {
        const __gm__ Aes128GcmTilingData* ctx_ptr = reinterpret_cast<const __gm__ Aes128GcmTilingData*>(ctx_addr);
        AES128GMMergeTag op;
        AscendC::TPipe pipe;
        op.Init(out, ghash_interm_gm, precomputed_gm, ctx_ptr, &pipe);
        op.Process();
    }
}

// PyTorch operator registration and host logic
namespace ascend_ops {
namespace AesGcm {
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("aes_gcm(Tensor input, Tensor key, Tensor nonce, Tensor aad) -> Tensor");
}

torch::Tensor aes_gcm_meta(
    const torch::Tensor& input, const torch::Tensor& key, const torch::Tensor& nonce, const torch::Tensor& aad)
{
    uint32_t rawSize = static_cast<uint32_t>(input.numel());
    uint32_t alignedSize = (rawSize + 511) / 512 * 512;
    if (alignedSize % 16 != 0)
        alignedSize = (alignedSize + 15) / 16 * 16;
    auto options = input.options().dtype(torch::kU8);
    return torch::empty({static_cast<int64_t>(alignedSize + GCM_TAG_SIZE)}, options);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m) { m.impl("aes_gcm", aes_gcm_meta); }

// NPU implementation of AesGcm
torch::Tensor aes_gcm_npu(
    const torch::Tensor& input, const torch::Tensor& key, const torch::Tensor& nonce, const torch::Tensor& aad)
{
    // OptionalDeviceGuard 确保后续操作在正确的设备上下文执行
    // 它会记录当前设备状态，执行完作用域代码后自动恢复
    const c10::OptionalDeviceGuard guard(input.device());
    auto output = aes_gcm_meta(input, key, nonce, aad);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    uint32_t rawSize = static_cast<uint32_t>(input.numel());
    uint32_t alignedSize = (rawSize + 511) / 512 * 512;
    if (alignedSize % 16 != 0)
        alignedSize = (alignedSize + 15) / 16 * 16;

    uint32_t numCores = 40;
    uint32_t ghashCoreNum = 20;

    void* inDev = nullptr;
    torch::Tensor alignedInput;
    if (rawSize == alignedSize) {
        inDev = input.data_ptr();
    } else {
        alignedInput = torch::zeros({static_cast<int64_t>(alignedSize)}, input.options().dtype(torch::kU8));
        alignedInput.narrow(0, 0, static_cast<int64_t>(rawSize)).copy_(input);
        inDev = alignedInput.data_ptr();
    }

    // 在 Host 侧构建 tiling 数据
    Aes128GcmTilingData tilingHost;
    memset(&tilingHost, 0, sizeof(tilingHost));
    auto key_cpu = key.cpu();
    TORCH_CHECK(key_cpu.numel() >= 176, "key must be at least 176 bytes (44 uint32_t round keys)");
    const uint32_t* key_u32 = reinterpret_cast<const uint32_t*>(key_cpu.data_ptr<uint8_t>());
    for (int i = 0; i < 44; i++)
        tilingHost.rd_key[i] = key_u32[i];
    auto nonce_cpu = nonce.cpu();
    TORCH_CHECK(nonce_cpu.numel() >= 12, "nonce must be at least 12 bytes");
    const uint8_t* nonce_ptr = nonce_cpu.data_ptr<uint8_t>();
    for (int i = 0; i < 12; i++)
        tilingHost.nonce[i] = nonce_ptr[i];
    auto aad_cpu = aad.cpu();
    uint32_t aad_len = static_cast<uint32_t>(aad_cpu.numel());
    TORCH_CHECK(aad_len <= 32, "aad must be <= 32 bytes");
    tilingHost.aad_len = aad_len;
    const uint8_t* aad_ptr = aad_cpu.data_ptr<uint8_t>();
    for (int i = 0; i < aad_len; i++)
        tilingHost.aad[i] = aad_ptr[i];
    tilingHost.totalDataSize = alignedSize;
    tilingHost.numCores = numCores;
    tilingHost.ghashCoreNum = ghashCoreNum;

    // 申请 Device 内存并拷贝 tiling 数据
    void* tilingDev = nullptr;
    void* precomputed = nullptr;
    void* ghashInterm = nullptr;
    aclError err = aclrtMalloc(&tilingDev, sizeof(Aes128GcmTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    TORCH_CHECK(err == ACL_SUCCESS, "aclrtMalloc tilingDev failed");
    err = aclrtMemcpy(
        tilingDev, sizeof(Aes128GcmTilingData), &tilingHost, sizeof(Aes128GcmTilingData), ACL_MEMCPY_HOST_TO_DEVICE);
    TORCH_CHECK(err == ACL_SUCCESS, "aclrtMemcpy tilingDev failed");
    size_t ghashIntermSize = (ghashCoreNum * 32 + 31) / 32 * 32;
    err = aclrtMalloc(&precomputed, 64, ACL_MEM_MALLOC_HUGE_FIRST);
    TORCH_CHECK(err == ACL_SUCCESS, "aclrtMalloc precomputed failed");
    err = aclrtMalloc(&ghashInterm, ghashIntermSize, ACL_MEM_MALLOC_HUGE_FIRST);
    TORCH_CHECK(err == ACL_SUCCESS, "aclrtMalloc ghashInterm failed");

    // 直接在流上启动 kernel 前先清空 torch_npu 任务队列，确保补零拷贝等主机侧操作已执行
    c10_npu::getCurrentNPUStream().synchronize();
    aes_128_gcm_precompute<<<1, nullptr, stream>>>((GM_ADDR)precomputed, (GM_ADDR)tilingDev);
    aclrtSynchronizeStream(stream);

    aes_128_gcm_encrypt<<<numCores, nullptr, stream>>>(
        alignedSize, numCores, (GM_ADDR)inDev, (GM_ADDR)output.data_ptr(), (GM_ADDR)tilingDev);
    aclrtSynchronizeStream(stream);

    aes_128_gcm_ghash_parallel<<<ghashCoreNum, nullptr, stream>>>(
        (GM_ADDR)output.data_ptr(), (GM_ADDR)ghashInterm, (GM_ADDR)precomputed, (GM_ADDR)tilingDev);
    aclrtSynchronizeStream(stream);

    aes_128_gcm_merge_tag<<<1, nullptr, stream>>>(
        (GM_ADDR)output.data_ptr(), (GM_ADDR)ghashInterm, (GM_ADDR)precomputed, (GM_ADDR)tilingDev);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDev);
    aclrtFree(precomputed);
    aclrtFree(ghashInterm);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m) { m.impl("aes_gcm", aes_gcm_npu); }
} // namespace AesGcm
} // namespace ascend_ops
