#include "../op_host/aice_launch.h"
#include "kernel_operator.h"
#include "acl/acl.h"
#include "device_dav2201.h"

/*
 * AICE Kernel data partition: B = BatchSize lanes per block, D = dim blocks.
 * One tile T contains uint16_t T[32][B]: 32 words/lane * 2 bytes * B = 64*B bytes.
 * Adjacent lanes in a word row are contiguous in GM; a lane's words have stride B.
 *
 * Example: ceil(length / (64*B)) = 10 tiles, D = 3 (quotient = 3, remainder = 1).
 * The matrix below expands every block's lane columns and local tile rows.
 * Blocks execute in parallel; each block processes its own tiles from top to bottom.
 *
 *              |<----- B lanes in block 0 ---->|<----- B lanes in block 1 ---->|<----- B lanes in block 2 ---->|
 * +------------+-------------------------------+-------------------------------+-------------------------------+
 * | local row  |        start=0, count=4       |        start=4, count=3       |        start=7, count=3       |
 * |            |   lane 0    ...    lane B-1   |   lane 0    ...    lane B-1   |   lane 0    ...    lane B-1   |
 * +------------+-------------------------------+-------------------------------+-------------------------------+
 * |  t=0, w=0  |   T0[0][0]  ...  T0[0][B-1]   |   T4[0][0]  ...  T4[0][B-1]   |   T7[0][0]  ...  T7[0][B-1]   |
 * |    ...     |              ...              |              ...              |              ...              |
 * | t=0, w=31  |   T0[31][0] ...  T0[31][B-1]  |   T4[31][0] ...  T4[31][B-1]  |   T7[31][0] ...  T7[31][B-1]  |
 * +------------+-------------------------------+-------------------------------+-------------------------------+
 * |  t=1, w=0  |   T1[0][0]  ...  T1[0][B-1]   |   T5[0][0]  ...  T5[0][B-1]   |   T8[0][0]  ...  T8[0][B-1]   |
 * |    ...     |              ...              |              ...              |              ...              |
 * | t=1, w=31  |   T1[31][0] ...  T1[31][B-1]  |   T5[31][0] ...  T5[31][B-1]  |   T8[31][0] ...  T8[31][B-1]  |
 * +------------+-------------------------------+-------------------------------+-------------------------------+
 * |  t=2, w=0  |   T2[0][0]  ...  T2[0][B-1]   |   T6[0][0]  ...  T6[0][B-1]   |   T9[0][0]  ...  T9[0][B-1]   |
 * |    ...     |              ...              |              ...              |              ...              |
 * | t=2, w=31  |   T2[31][0] ...  T2[31][B-1]  |   T6[31][0] ...  T6[31][B-1]  |   T9[31][0] ...  T9[31][B-1]  |
 * +------------+-------------------------------+-------------------------------+-------------------------------+
 * |  t=3, w=0  |   T3[0][0]  ...  T3[0][B-1]   |                               |                               |
 * |    ...     |              ...              |           block done          |           block done          |
 * | t=3, w=31  |   T3[31][0] ...  T3[31][B-1]  |                               |                               |
 * +------------+-------------------------------+-------------------------------+-------------------------------+
 *
 * The matrix is an execution view. GM tile order is block-major, as below:
 *   low address                                                        high address
 *   +----+----+----+----+----+----+----+----+----+----+
 *   | T0 | T1 | T2 | T3 | T4 | T5 | T6 | T7 | T8 | T9 |
 *   +----+----+----+----+----+----+----+----+----+----+
 *   |<---- block 0 --->|<-- block 1 -->|<-- block 2 -->|
 *
 * Tj[w][lane] byte offset = j*(64*B) + 2*(w*B + lane).
 * Each block initializes B lane states once, then preserves them across its tiles.
 * T9 may be partial: only bytes within length are read/written, with no GM padding.
 * If total tiles < D, blocks with count=0 return before initializing any state.
 */
template <uint32_t BatchSize, bool Encrypting>
__global__ __aicore__ void AiceKernel(GM_ADDR input, GM_ADDR key, GM_ADDR iv, GM_ADDR output, uint32_t length)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr uint32_t tileBytes = 64U * BatchSize;
    const uint32_t blocks = length / tileBytes + (length % tileBytes != 0U ? 1U : 0U);
    const uint32_t index = AscendC::GetBlockIdx();
    const uint32_t dim = AscendC::GetBlockNum();
    const uint32_t quotient = blocks / dim;
    const uint32_t remainder = blocks % dim;
    const uint32_t count = quotient + (index < remainder ? 1U : 0U);
    const uint32_t start = index * quotient + (index < remainder ? index : remainder);
    if (count == 0) {
        return;
    }
    cann_crypto::algorithms::cipher::aice::AiceDevice<BatchSize> op;
    const size_t byteOffset = static_cast<size_t>(start) * tileBytes;
    const size_t capacity = static_cast<size_t>(count) * tileBytes;
    const size_t remaining = static_cast<size_t>(length) - byteOffset;
    const size_t inputLength = capacity < remaining ? capacity : remaining;
    op.Init(input + byteOffset, key, iv, output + byteOffset, inputLength, index);
    if constexpr (Encrypting) {
        op.Encrypt(0, inputLength);
    } else {
        op.Decrypt(0, inputLength);
    }
    op.Destroy();
}

namespace {
template <uint32_t BatchSize, bool Encrypting>
int32_t Launch(
    uint32_t dim, void* stream, const uint8_t* input, const uint8_t* key, const uint8_t* iv, uint8_t* output,
    uint32_t length)
{
    AiceKernel<BatchSize, Encrypting>
        <<<dim, nullptr, stream>>>((GM_ADDR)input, (GM_ADDR)key, (GM_ADDR)iv, (GM_ADDR)output, length);
    return ACL_SUCCESS;
}
template <bool Encrypting>
int32_t Dispatch(
    uint32_t batch, uint32_t dim, void* stream, const uint8_t* input, const uint8_t* key, const uint8_t* iv,
    uint8_t* output, uint32_t length)
{
    switch (batch) {
        case 128:
            return Launch<128, Encrypting>(dim, stream, input, key, iv, output, length);
        case 256:
            return Launch<256, Encrypting>(dim, stream, input, key, iv, output, length);
        case 512:
            return Launch<512, Encrypting>(dim, stream, input, key, iv, output, length);
        default:
            return ACL_ERROR_INVALID_PARAM;
    }
}
} // namespace
extern "C" int32_t CannCryptoAiceLaunch(
    uint32_t batch, bool encrypt, uint32_t dim, void* stream, const uint8_t* input, const uint8_t* key,
    const uint8_t* iv, uint8_t* output, uint32_t length)
{
    if (encrypt) {
        return Dispatch<true>(batch, dim, stream, input, key, iv, output, length);
    }
    return Dispatch<false>(batch, dim, stream, input, key, iv, output, length);
}
