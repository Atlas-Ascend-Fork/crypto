#include "kernel_operator.h"
#include "../../../../primitives/sm3/op_kernel/sm3_device_internal.h"
#include "../../../../primitives/sm3/op_kernel/sm3_words_internal.h"

__global__ __aicore__ void Sm3BatchKernel(
    GM_ADDR rows, GM_ADDR bytes, GM_ADDR result, uint32_t count, uint32_t uniformLength, uint32_t uniformMode)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::GlobalTensor<uint32_t> descriptors;
    AscendC::GlobalTensor<uint8_t> input, output;
    AscendC::GlobalTensor<uint32_t> input32;
    input32.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(bytes));
    const bool baseAligned = (reinterpret_cast<uint64_t>(bytes) & 3) == 0;
    if (!uniformMode)
        descriptors.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(rows), count * 2);
    input.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(bytes));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(result), count * 32);
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, 32);
    auto local = buffer.Get<uint8_t>();
    for (uint32_t record = AscendC::GetBlockIdx(); record < count; record += AscendC::GetBlockNum()) {
        const uint32_t offset = uniformMode ? record * uniformLength : descriptors.GetValue(2 * record);
        const uint32_t length = uniformMode ? uniformLength : descriptors.GetValue(2 * record + 1);
        volatile uint8_t digest[32];
        cann_crypto::sm3::device::HashWords(input, input32, baseAligned, offset, length, digest);

        // Each record owns one aligned 32-byte DMA block. Scalar GM writes
        // from different AIVs can share a cache line and lose adjacent digests.
        for (uint32_t j = 0; j < 32; ++j)
            local.SetValue(j, digest[j]);
        const auto ready = pipe.FetchEventID(AscendC::HardEvent::S_MTE3);
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(ready);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(ready);
        AscendC::DataCopy(output[record * 32], local, 32);
        const auto done = pipe.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(done);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(done);
    }
}
extern "C" void CannCryptoSm3VectorLaunch(uint32_t, void*, const uint8_t*, uint8_t*, uint32_t, uint32_t);
extern "C" void CannCryptoSm3Launch(
    uint32_t blocks, void* stream, const uint32_t* rows, const uint8_t* bytes, uint8_t* result, uint32_t count,
    uint32_t uniformLength, uint32_t uniformMode)
{
    if (CANN_CRYPTO_SM3_VECTOR_ENABLED && uniformMode && count >= 2048 && uniformLength <= 8192) {
        CannCryptoSm3VectorLaunch(blocks, stream, bytes, result, count, uniformLength);
        return;
    }
    Sm3BatchKernel<<<blocks, nullptr, stream>>>(
        (GM_ADDR)rows, (GM_ADDR)bytes, (GM_ADDR)result, count, uniformLength, uniformMode);
}
