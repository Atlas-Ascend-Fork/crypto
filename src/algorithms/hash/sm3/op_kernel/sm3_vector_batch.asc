#define SM3_VECTOR_WIDTH SM3_VECTOR_TILE
#define SM3_VECTOR_KERNEL Sm3VectorBatchKernel
#define SM3_VECTOR_LAUNCH CannCryptoSm3VectorNarrowLaunch
#include "sm3_vector_batch_internal.h"
extern "C" void CannCryptoSm3VectorWideLaunch(uint32_t, void*, const uint8_t*, uint8_t*, uint32_t, uint32_t);
extern "C" void CannCryptoSm3VectorLaunch(
    uint32_t blocks, void* stream, const uint8_t* input, uint8_t* output, uint32_t count, uint32_t length)
{
    // This threshold is measured on 910B3. Each backend clamps blocks to tiles.
    if (count >= 16384)
        CannCryptoSm3VectorWideLaunch(blocks, stream, input, output, count, length);
    else
        CannCryptoSm3VectorNarrowLaunch(blocks, stream, input, output, count, length);
}
