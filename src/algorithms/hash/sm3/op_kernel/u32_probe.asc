#include "kernel_operator.h"
#include "../../../../math/bitops/u32/op_kernel/vector_u32.h"
using namespace AscendC;
__global__ __aicore__ void Sm3U32ProbeKernel(GM_ADDR in, GM_ADDR out, uint32_t n)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr uint32_t q = 128;
    GlobalTensor<uint32_t> input, output;
    input.SetGlobalBuffer((__gm__ uint32_t*)in, 2 * n);
    output.SetGlobalBuffer((__gm__ uint32_t*)out, 12 * n);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, (2 + 12 + 6) * q * 4);
    auto m = buffer.Get<uint32_t>();
    cann_crypto::math::u32::Vector v{m[14 * q], q};
    for (uint32_t base = GetBlockIdx() * q; base < n; base += GetBlockNum() * q) {
        DataCopy(m, input[base], q);
        DataCopy(m[q], input[n + base], q);
        const auto ready = pipe.FetchEventID(HardEvent::MTE2_V);
        SetFlag<HardEvent::MTE2_V>(ready);
        WaitFlag<HardEvent::MTE2_V>(ready);
        v.Add(m[2 * q], m, m[q]);
        v.Xor(m[3 * q], m, m[q]);
        v.Copy(m[4 * q], m);
        v.Rotl(m[4 * q], m[4 * q], 7);
        v.Not(m[5 * q], m);
        v.And(m[6 * q], m, m[q]);
        v.Or(m[7 * q], m, m[q]);
        v.Permute(m[8 * q], m, 9, 17);
        v.Sub(m[9 * q], m, m[q]);
        v.Rotl(m[10 * q], m, 0);
        v.ByteSwap(m[11 * q], m);
        v.AddScalar(m[12 * q], m, 0x7a879d8aU);
        v.AddScalar(m[13 * q], m, 0xf4f0c766U);
        const auto done = pipe.FetchEventID(HardEvent::V_MTE3);
        SetFlag<HardEvent::V_MTE3>(done);
        WaitFlag<HardEvent::V_MTE3>(done);
        for (uint32_t j = 0; j < 12; ++j)
            DataCopy(output[j * n + base], m[(j + 2) * q], q);
        // Inputs are also read by V and reused by MTE2; drain all relevant reads.
        pipe_barrier(PIPE_ALL);
    }
}
extern "C" void CannCryptoSm3U32Probe(void* stream, const uint32_t* input, uint32_t* output, uint32_t n)
{
    Sm3U32ProbeKernel<<<40, nullptr, stream>>>((GM_ADDR)input, (GM_ADDR)output, n);
}
