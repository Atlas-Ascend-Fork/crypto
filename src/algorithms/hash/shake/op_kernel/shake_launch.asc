#include "shake128_tensor.cpp"
#include "shake256_tensor.cpp"

extern "C" void CannCryptoShakeLaunch(
    uint32_t bits, uint32_t blockDim, void* stream, const uint8_t* input, uint8_t* output, uint32_t batch,
    uint32_t inputLength, uint32_t outputLength, uint32_t groupSize)
{
    // GM_ADDR adds the __gm__ address space; use the CANN launch cast.
    GM_ADDR x = (GM_ADDR)input;
    GM_ADDR y = (GM_ADDR)output;
    if (bits == 128U) {
        shake128_tensor<<<blockDim, nullptr, stream>>>(x, y, batch, inputLength, outputLength, groupSize);
    } else {
        shake256_tensor<<<blockDim, nullptr, stream>>>(x, y, batch, inputLength, outputLength, groupSize);
    }
}
